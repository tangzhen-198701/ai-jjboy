{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "pnpm-lock.yaml",
    "data/**",
    "outputs/**",
    ".git/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./config/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "project-words"
  ],
  "ignoreRegExpList": [
    "/[\\u3400-\\u9fff]+/g"
  ]
}
