{
  "name": "ai-douyin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --project tsconfig.tools.json --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "spellcheck": "cspell --no-progress --no-must-find-files \"**/*\" \".agents/**/*.md\" \".github/**/*.yml\"",
    "check:names": "node --import tsx scripts/check-names.ts",
    "check": "pnpm check:names && pnpm lint && pnpm spellcheck && pnpm typecheck && pnpm test && pnpm build",
    "test": "node --import tsx --test apps/server/src/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "jiti": "^2.6.0",
    "cspell": "^9.0.0",
    "globals": "^16.0.0"
  }
}
